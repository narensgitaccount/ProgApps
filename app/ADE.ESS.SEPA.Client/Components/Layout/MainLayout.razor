@inherits LayoutComponentBase
@using Telerik.Blazor
@using Telerik.Blazor.Components
@using Telerik.SvgIcons
@inject NavigationManager Navigation
@inject ADE.ESS.SEPA.Application.Interfaces.IAppStateService AppState

<TelerikRootComponent>
    <div class="sepa-shell">
        <header class="sepa-header">
            <NavLink href="/" class="sepa-brand">
                <img src="img/ADESealLogo.png" alt="Arizona Department of Education seal" class="sepa-seal" />
                <div>
                    <div class="sepa-brand-title">Special Education Program Approvals (SEPA)</div>
                    <div class="sepa-brand-subtitle">EXCEPTIONAL STUDENT SERVICES</div>
                </div>
            </NavLink>
        </header>

        <nav class="sepa-nav">
            <div class="sepa-nav-left">
                <NavLink href="/" class="sepa-nav-link" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink href="/dashboard" class="sepa-nav-link" Match="NavLinkMatch.Prefix">Application Dashboard</NavLink>
                <TelerikDropDownButton Class="sepa-nav-dropdown" FillMode="@ThemeConstants.Button.FillMode.Flat">
                    <DropDownButtonContent>Info</DropDownButtonContent>
                    <DropDownButtonItems>
                        <DropDownButtonItem OnClick="@(() => GoTo("/Info"))">Program Information</DropDownButtonItem>
                    </DropDownButtonItems>
                </TelerikDropDownButton>
            </div>

            <div class="sepa-nav-right">
                <NavLink href="/Info" class="sepa-nav-link sepa-help" Match="NavLinkMatch.Prefix">
                    <TelerikSvgIcon Icon="@SvgIcon.QuestionCircle" />
                    Help
                </NavLink>
                <TelerikDropDownButton Class="sepa-nav-dropdown" FillMode="@ThemeConstants.Button.FillMode.Flat">
                    <DropDownButtonContent>Welcome, @UserDisplayName</DropDownButtonContent>
                    <DropDownButtonItems>
                        <DropDownButtonItem OnClick="@SignOut">Sign out</DropDownButtonItem>
                    </DropDownButtonItems>
                </TelerikDropDownButton>
            </div>
        </nav>

        <main class="sepa-content">
            @Body
        </main>

        <footer class="sepa-footer">
            <div class="sepa-footer-left">
                <div class="sepa-footer-heading">ARIZONA DEPARTMENT OF EDUCATION</div>
                <div>Private Special Education School &amp; RTC Approval</div>
                <div>1535 W. Jefferson Street, Bin #24</div>
                <div>Phoenix, AZ 85007</div>
            </div>
            <div class="sepa-footer-right">
                <div class="sepa-footer-heading sepa-gold">Arizona's Official Website</div>
                <div>For any questions, comments, or concerns,<br />please feel free to <span class="sepa-gold">contact us</span>.</div>
                <div class="sepa-copyright">&copy;@DateTime.Now.Year All rights reserved.</div>
            </div>
        </footer>
    </div>
</TelerikRootComponent>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string UserDisplayName
    {
        get
        {
            var user = AppState.CurrentState?.User;
            var name = $"{user?.FirstName} {user?.LastName}".Trim();
            return name.Length > 0 ? name : "Guest";
        }
    }

    private void GoTo(string url) => Navigation.NavigateTo(url);

    private void SignOut() => Navigation.NavigateTo("/signout", forceLoad: true);
}
